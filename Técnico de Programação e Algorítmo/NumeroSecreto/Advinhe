import java.util.Random;
import java.util.Scanner;

public class NumeroSecreto {
    public static void main(String[] args) {
        try (Scanner scanner = new Scanner(System.in)) {
            Random random  = new Random ();
            
            int numeroSecreto = random.nextInt(1, 11);
            int palpiteDoUsuario = 0;
            int tentativas = 0;
        
            System.out.println ("Digite um número de 1 a 10: ");
            
            do {   
                palpiteDoUsuario = scanner.nextInt();
                tentativas++;
                
                if (palpiteDoUsuario<numeroSecreto) {
                    System.out.println ("Digite um número maior");
                } else if (palpiteDoUsuario>numeroSecreto) {
                    System.out.println ("Digite um número menor");
                } 
              } while  (palpiteDoUsuario != numeroSecreto);
            
            {  System.out.println("Parabéns, você acertou em " + tentativas + " tentativas!");
               }
           }
        }
    }
